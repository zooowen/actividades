erminante",1],["Pronombre"]],"Acompaña a «lápiz»: determinante."],["m","No tengo <u>ninguno</u>.",[["Pronombre",1],["Determinante"]],"Va solo: pronombre."],["m","<u>Nadie</u> sabe la respuesta.",[["Pronombre",1],["Determinante"]],"«Nadie» siempre es pronombre."],["m","Hay <u>muchas</u> flores.",[["Determinante",1],["Pronombre"]],"Acompaña a «flores»."],["m","¿Quieres caramelos? Toma <u>varios</u>.",[["Pronombre",1],["Determinante"]],"Va solo (sustituye a «caramelos»)."],["m","<u>Algo</u> huele raro.",[["Pronombre",1],["Determinante"]],"«Algo» siempre es pronombre."],["m","<u>Cada</u> alumno tiene un libro.",[["Determinante",1],["Pronombre"]],"«Cada» siempre acompaña a un sustantivo."],["m","Vinieron <u>todos</u>.",[["Pronombre",1],["Determinante"]],"Va solo: pronombre."]]],["Indefinidos 14 · género y número","Muchos indefinidos cambian según el sustantivo: mucho, mucha, muchos, muchas.",[["m","Tengo <strong>_____</strong> amigas.",[["muchas",1],["muchos"],["mucha"],["mucho"]],"Amigas (femenino plural): <strong>muchas</strong>."],["m","Hay <strong>_____</strong> gente en la calle.",[["poca",1],["poco"],["pocas"],["pocos"]],"Gente (femenino singular): <strong>poca</strong>."],["m","<strong>_____</strong> días voy en bici.",[["Algunos",1],["Algunas"],["Alguna"],["Algún"]],"Días (masculino plural): <strong>algunos</strong>."],["m","No hay <strong>_____</strong> problema.",[["ningún",1],["ninguna"],["ninguno"],["ningunos"]],"Delante de masculino singular: <strong>ningún</strong>."],["m","Comí <strong>_____</strong> la pizza.",[["toda",1],["todo"],["todas"],["todos"]],"La pizza (femenino singular): <strong>toda</strong>."],["m","Quiero <strong>_____</strong> vaso de agua.",[["otro",1],["otra"],["un otro"],["otros"]],"Masculino singular: <strong>otro</strong> (¡nunca «un otro»!)."],["m","Tengo <strong>_____</strong> ideas.",[["varias",1],["varios"],["varia"],["vario"]],"Ideas (femenino plural): <strong>varias</strong>."],["m","<strong>_____</strong> semana hay examen.",[["