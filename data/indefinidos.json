vo."],["x","Une cada indefinido con lo que significa.",[["alguien","una persona (no sabemos quién)"],["algo","una cosa (no sabemos qué)"],["nadie","ninguna persona"],["nada","ninguna cosa"]],"Alguien/nadie → personas; algo/nada → cosas."],["x","Une cada indefinido con su femenino.",[["algún","alguna"],["ningún","ninguna"],["mucho","mucha"],["otro","otra"]],"Masculino → femenino."],["x","Une cada frase con su contrario.",[["Hay alguien.","No hay nadie."],["Tengo algo.","No tengo nada."],["Tengo algún amigo.","No tengo ningún amigo."],["Siempre llego pronto.","Nunca llego pronto."]],"Afirmativo ↔ negativo."],["x","Une cada indefinido con su plural.",[["alguno","algunos"],["otra","otras"],["poco","pocos"],["toda","todas"]],"El plural se forma con -s."],["x","Une cada expresión con su significado.",[["todo el mundo","todas las personas"],["cada día","todos los días"],["de nada","respuesta a «gracias»"],["algún día","en el futuro, no sabemos cuándo"]],"Expresiones muy útiles."]]],["Indefinidos 10 · escribe","Escribe el indefinido que falta.",[["s","—¿Hay <strong>_____</strong> en la puerta? —No, no hay nadie. <em>(Escribe la respuesta.)</em>",[["alguien",1]],"Pregunta sobre personas: <strong>alguien</strong>."],["s","No tengo <strong>_____</strong> en la mochila. Está vacía. <em>(Escribe la respuesta.)</em>",[["nada",1]],"Ninguna cosa: <strong>nada</strong>."],["s","<strong>_____</strong> ha comido mi bocadillo. ¿Quién ha sido? <em>(Escribe la respuesta.)</em>",[["Alguien",1],["alguien",1]],"Una persona desconocida: <strong>alguien</strong>."],["s","¿Quieres <strong>_____</strong> de beber? <em>(Escribe la respuesta.)</em>",[["algo",1]],"Una cosa: <strong>algo</strong>."],["s","No hay <strong>_____</strong> en el parque porque llueve. <em>(Escribe la respuesta.)</em>",[["nadie",1]],"Ninguna persona: <strong>nadie</strong>."],["s","No tengo <strong>_____</strong> hermano, pero tengo dos hermanas. <em>(Escribe la respuesta.)</em>",[["ningún",1]],"Masculino singular delante del sustantivo: <strong>ningún</strong>."],["s","¿Tienes <strong>_____</strong> pregunta? <em>(Escribe la respuesta.)</em>",[["alguna",1]],"Femenino singular: <strong>alguna</strong>."],["s","Quiero <strong>_____</strong> trozo de tarta, por favor. <em>(Escribe la respuesta.)</em>",[["otro",1]],"Sin «un» delante: <strong>otro</strong>."],["s","<strong>_____</strong> los alumnos aprobaron el examen. <em>(Escribe la respuesta.)</em>",[["Todos",1],["todos",1]],"Masculino plural: <strong>todos</strong>."],["s","Hay <strong>_____</strong> gente en el centro comercial. <em>(Escribe la respuesta.)</em>",[["mucha",1]],"«Gente» es femenino singular: <strong>mucha</strong>."]]],["Indefinidos 11 · busca los indefinidos","Marca todos los indefinidos de cada frase.",[["a","«Alguien ha dejado algo en mi mesa.» <em>(Marca todas las correctas.)</em>",[["Alguien",1],["algo",1],["ha"],["mi"],["mesa"]],"Indefinidos: <strong>alguien</strong> y <strong>algo</strong>."],["a","«No hay nadie y no se oye nada.» <em>(Marca todas las correctas.)</em>",[["nadie",1],["nada",1],["No"],["hay"],["oye"]],"Indefinidos: <strong>nadie</strong> y <strong>nada</strong>."],["a","«Todos los niños tienen algún juguete.» <em>(Marca todas las correctas.)</em>",[["Todos",1],["algún",1],["niños"],["tienen"],["juguete"]],"Indefinidos: <strong>todos</strong> y <strong>algún</strong>."],["a","«Hay muchas nubes y pocos pájaros.» <em>(Marca todas las correctas.)</em>",[["muchas",1],["pocos",1],["Hay"],["nubes"],["pájaros"]],"Indefinidos: <strong>muchas</strong> y <strong>pocos</strong>."],["a","«Cada niño trae otra mochila.» <em>(Marca todas las correctas.)</em>",[["Cada",1],["otra",1],["niño"],["trae"],["mochila"]],"Indefinidos: <strong>cada</strong> y <strong>otra</strong>."],["a","«Varias niñas no tienen ningún lápiz.» <em>(Marca todas las correctas.)</em>",[["Varias",1],["ningún",1],["niñas"],["tienen"],["lápiz"]],"Indefinidos: <strong>varias</strong> y <strong>ningún</strong>."]]],["Indefinidos 12 · repaso","