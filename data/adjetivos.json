."],["m","El limón no es dulce. Es…",[["ácido",1],["salado"],["caliente"],["blando"]],"El sabor del limón es <strong>ácido</strong>."],["m","La biblioteca no tiene ruido. Es…",[["silenciosa",1],["ruidosa"],["oscura"],["divertida"]],"Sin ruido: <strong>silenciosa</strong>."],["m","Este juego me hace reír mucho. Es…",[["divertido",1],["aburrido"],["difícil"],["triste"]],"Me hace reír: <strong>divertido</strong>."],["m","El bombero entra en el fuego para salvar a un gato. Es…",[["valiente",1],["miedoso"],["perezoso"],["débil"]],"No tiene miedo: <strong>valiente</strong>."]]],["Adjetivos 12 · adjetivos en frases","Elige el adjetivo correcto para cada frase.",[["m","Las montañas de Utah son muy <strong>_____</strong>.",[["altas",1],["alto"],["altos"],["alta"]],"«Montañas» es femenino plural: <strong>altas</strong>."],["m","Mis zapatillas <strong>_____</strong> están en la mochila.",[["nuevas",1],["nuevos"],["nueva"],["nuevo"]],"Femenino plural: <strong>nuevas</strong>."],["m","El cielo está <strong>_____</strong> hoy.",[["azul",1],["azula"],["azules"],["azulo"]],"«Azul» no cambia en masculino y femenino; en plural es «azules»."],["m","Los peces <strong>_____</strong> nadan en el río.",[["pequeños",1],["pequeñas"],["pequeño"],["pequeña"]],"Masculino plural: <strong>pequeños</strong>."],["m","Mi madre es muy <strong>_____</strong>.",[["trabajadora",1],["trabajador"],["trabajadores"],["trabajadoras"]],"Los adjetivos en -or añaden -a en femenino: <strong>trabajadora</strong>."],["m","Los niños están <strong>_____</strong> porque es su cumpleaños.",[["felices",1],["feliz"],["felizes"],["felics"]],"Plural de «feliz»: <strong>felices</strong> (la z cambia a c)."],["m","La película fue muy <strong>_____</strong>.",[["divertida",1],["divertido"],["divertidas"],["divertidos"]],"Femenino singular: <strong>divertida</strong>."],["m","Las clases de ciencias son <strong>_____</strong>.",[["interesantes",1],["interesante"],["interesantas"],["interesantos"]],"Plural de «interesante»: <strong>interesantes</strong>."],["m","Este libro es más <strong>_____</strong> que el otro.",[["largo",1],["larga"],["largos"],["largas"]],"Masculino singular: <strong>largo</strong>."],["m","Las calles de mi barrio están <strong>_____</strong>.",[["limpias",1],["limpios"],["limpia"],["limpio"]],"Femenino plural: <strong>limpias</strong>."]]],["Adjetivos 13 · repaso","Repaso de los adjetivos.",[["m","¿Cuál es el contrario de <strong>abierto</strong>?",[["cerrado",1],["claro"],["lleno"],["alto"]],"abierto ↔ cerrado."],["m","La nieve es <strong>_____</strong>.",[["blanca",1],["blanco"],["blancas"],["blancos"]],"Femenino singular: <strong>blanca</strong>."],["a","¿Cuáles son adjetivos? <em>(Marca todas las correctas.)</em>",[["bonito",1],["rápida",1],["verdes",1],["correr"],["mesa"],["ayer"]],"Los adjetivos dicen cómo es algo."],["m","Los osos son animales muy <strong>_____</strong>.",[["fuertes",1],["fuerte"],["fuertas"],["fuertos"]],"Plural: <strong>fuertes</strong>."],["m","¿Cuál es el contrario de <strong>caro</strong>?",[["barato",1],["rico"],["pobre"],["nuevo"]],"caro ↔ barato."],["m","Mi amiga Lucía es muy <strong>_____</strong>.",[["habladora",1],["hablador"],["habladores"],["habladoras"]],"Adjetivo en -or + a: <strong>habladora</strong>."],["m","Las sillas de la clase son <strong>_____</strong>.",[["azules",1],["azul"],["azulas"],["azuls"]],"Plural de «azul»: <strong>azules</strong>."],["m","¿Cuál es el contrario de <strong>mojado</strong>?",[["seco",1],["sucio"],["frío"],["triste"]],"mojado ↔ seco."],["m","El agua del mar está <strong>_____</strong>.",[["salada",1],["salado"],["saladas"],["dulce"]],"«Agua» es femenina: <strong>salada</strong> (aunque digamos «el agua»)."],["m","Mis hermanos son muy <strong>_____</strong>.",[["divertidos",1],["divertidas"],["divertido"],["divertida"]],"Masculino plural: <strong>divertidos</strong>."]]],["Adjetivos 14 · buen, mal, gran","Delante de un sustantivo masculino singular: <strong>bueno → buen</strong>, <strong>malo → mal</strong>. Delante de cualquier sustantivo singular: <strong>grande → gran</strong>.",[["m","Es un <strong>_____</strong> amigo.",[["buen",1],["bueno"],["buena"],["buenos"]],"Delante de un sustantivo masculino singular: <strong>buen</strong>."],["m","Este amigo es muy <strong>_____</strong>.",[["bueno",1],["buen"],["buena"],["bien"]],"Detrás del sustantivo o del verbo: <strong>bueno</strong>."],["m","Hoy hace <strong>_____</strong> tiempo.",[["mal",1],["malo"],["mala"],["males"]],"Delante de «tiempo»: <strong>mal</strong>."],["m","Es una <strong>_____</strong> ciudad.",[["gran",1],["grande"],["grandes"],["gran de"]],"Delante de un sustantivo singular (también femenino): <strong>gran</strong>."],["m","Vivo en una casa <strong>_____</strong>.",[["grande",1],["gran"],["grandes"],["granda"]],"Detrás del sustantivo: <strong>grande</strong> (tamaño)."],["m","Es una <strong>_____</strong> idea.",[["buena",1],["buen"],["bueno"],["buenas"]],"Femenino: <strong>buena</strong> (no cambia)."],["m","Tuvimos un <strong>_____</strong> día.",[["mal",1],["malo"],["mala"],["malos"]],"Delante de «día»: <strong>mal</strong>."],["m","Son unos <strong>_____</strong> jugadores.",[["grandes",1],["gran"],["grande"],["granes"]],"En plural no hay apócope: <strong>grandes</strong>."],["m","«Un gran hombre» significa…",[["un hombre importante o admirable",1],["un hombre muy alto"],["un hombre gordo"],["un hombre viejo"]],"Delante, <strong>gran</strong> suele significar «importante»; detrás, «grande» habla del tamaño."],["s","Es el <strong>_____</strong> (primero) día de clase. <em>(Escribe la respuesta.)</em>",[["primer",1]],"También <strong>primero → primer</strong> y <strong>tercero → tercer</strong>."]]],["Adjetivos 15 · el carácter","Adjetivos para describir cómo es una persona.",[["x","Une cada adjetivo con su significado.",[["generoso","comparte lo que tiene"],["tímido","le cuesta hablar con gente nueva"],["valiente","no tiene miedo"],["perezoso","no le gusta trabajar"]],"Son adjetivos de carácter."],["x","Une cada adjetivo con su significado.",[["sincero","dice siempre la verdad"],["paciente","sabe esperar con calma"],["simpático","es agradable y cae bien"],["egoísta","solo piensa en sí mismo"]],"Más adjetivos de carácter."],["m","Marta siempre ayuda a todos. Es muy…",[["amable",1],["egoísta"],["perezosa"],["tímida"]],"Quien ayuda es <strong>amable</strong>."],["m","Pablo nunca dice mentiras. Es…",[["sincero",1],["mentiroso"],["tímido"],["gracioso"]],"Quien dice la verdad es <strong>sincero</strong>."],["m","Lucía cuenta chistes y todos se ríen. Es…",[["graciosa",1],["seria"],["tímida"],["triste"]],"Quien hace reír es <strong>graciosa</strong>."],["m","El contrario de «trabajador» es…",[["perezoso",1],["generoso"],["valiente"],["alegre"]],"Trabajador ↔ <strong>perezoso</strong>."],["m","El contrario de «optimista» es…",[["pesimista",1],["realista"],["egoísta"],["artista"]],"Optimista ↔ <strong>pesimista</strong>."],["m","Mi abuelo escucha y espera sin enfadarse. Es…",[["paciente",1],["impaciente"],["nervioso"],["egoísta"]],"Quien sabe esperar es <strong>paciente</strong>."],["s","El contrario de «valiente» es <strong>_____</strong>. <em>(Escribe la respuesta.)</em>",[["cobarde",1],["miedoso",1]],"Valiente ↔ <strong>cobarde</strong> (o miedoso)."],["s","El contrario de «generoso» es <strong>_____</strong>. <em>(Escribe la respuesta.)</em>",[["egoísta",1],["tacaño",1]],"Generoso ↔ <strong>egoísta</strong> o tacaño."]]]]}