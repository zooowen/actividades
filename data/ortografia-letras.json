{"tema":"Ortografía: B/V, C/Z, H…","ico":"🅱️","color":"#f77f00","intro":"Algunas letras suenan igual y nos hacen dudar: <strong>b/v</strong>, <strong>c/z/qu</strong>, <strong>g/j</strong> y la <strong>h</strong>, que no suena.","reglas":[["🅱️","B y V","Con <strong>b</strong>: después de m (<em>hombre</em>), antes de l y r (<em>blanco, brazo</em>), los verbos en -aba (<em>cantaba</em>). Con <strong>v</strong>: después de n (<em>invierno</em>), los adjetivos en -avo, -ivo (<em>octavo, activo</em>)."],["🔤","C, Z y QU","Sonido /k/: <strong>ca, co, cu, que, qui</strong>. Sonido /z/: <strong>za, ce, ci, zo, zu</strong>."],["🇬","G y J","Sonido /g/: <strong>ga, gue, gui, go, gu</strong>. Sonido /j/: <strong>ja, je/ge, ji/gi, jo, ju</strong>. Con diéresis: <em>pingüino, cigüeña</em>."],["🤫","La H","No suena. Llevan h las palabras que empiezan por <strong>hue-, hie-, hum-</strong> (<em>huevo, hielo, humo</em>) y muchas otras que hay que aprender."]],"grupos":[["🅱️ B y V","Ejercicios 1 y 2",2],["🔤 C, Z y QU","Ejercicios 3 y 4",2],["🇬 G y J","Ejercicio 5",1],["🤫 La H","Ejercicio 6",1],["🎧 Dictados","Ejercicios 7 y 8",2]],"quizzes":[["B/V 1 · ¿con b o con v?","Elige la palabra bien escrita.",[["m","¿Cómo se escribe?",[["ventana",1],["bentana"]],"<strong>ventana</strong>."],["m","¿Cómo se escribe?",[["hombre",1],["homvre"]],"<strong>hombre</strong>."],["m","¿Cómo se escribe?",[["blanco",1],["vlanco"]],"<strong>blanco</strong>."],["m","¿Cómo se escribe?",[["cantaba",1],["cantava"]],"<strong>cantaba</strong>."],["m","¿Cómo se escribe?",[["invierno",1],["inbierno"]],"<strong>invierno</strong>."],["m","¿Cómo se escribe?",[["brazo",1],["vrazo"]],"<strong>brazo</strong>."],["m","¿Cómo se escribe?",[["nieve",1],["niebe"]],"<strong>nieve</strong>."],["m","¿Cómo se escribe?",[["octavo",1],["octabo"]],"<strong>octavo</strong>."],["m","¿Cómo se escribe?",[["bicicleta",1],["vicicleta"]],"<strong>bicicleta</strong>."],["m","¿Cómo se escribe?",[["llave",1],["llabe"]],"<strong>llave</strong>."]