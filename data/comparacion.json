{"tema":"Comparación","ico":"📏","color":"#0b8577","intro":"Para comparar usamos <strong>más… que</strong>, <strong>menos… que</strong> y <strong>tan… como</strong>. Para destacar, el superlativo: <em>el más alto, altísimo</em>.","reglas":[["⬆️","Superioridad","<strong>más</strong> + adjetivo + <strong>que</strong>: <em>Ana es más alta que Luis.</em>"],["⬇️","Inferioridad","<strong>menos</strong> + adjetivo + <strong>que</strong>: <em>El tren es menos rápido que el avión.</em>"],["🟰","Igualdad","<strong>tan</strong> + adjetivo + <strong>como</strong>; <strong>tanto/a/os/as</strong> + sustantivo + <strong>como</strong>."],["🏆","Irregulares y superlativo","<em>mejor, peor, mayor, menor</em>. Superlativo: <em>el más alto, muy alto, altísimo</em>."]],"grupos":[["⬆️ Más, menos, tan","Ejercicios 1 a 3",3],["🏆 Irregulares y superlativos","Ejercicios 4 a 6",3],["🧠 Repaso","Ejercicio 7",1]],"quizzes":[["Comparación 1 · más / menos que","Elige la palabra que falta.",[["m","Un elefante es <strong>_____</strong> grande que un ratón.",[["más",1],["menos"],["tan"],["tanto"]],"Superioridad."],["m","Una tortuga es <strong>_____</strong> rápida que un caballo.",[["menos",1],["más"],["tan"],["tanta"]],"Inferioridad."],["m","Mi hermano es más alto <strong>_____</strong> yo.",[["que",1],["como"],["de"],["tan"]],"más… <strong>que</strong>."],["m","El sol es <strong>_____</strong> caliente que la luna.",[["más",1],["menos"],["tan"],["como"]],"Superioridad."],["m","Invierno es <strong>_____</strong> caluroso que verano.",[["menos",1],["más"],["tan"],["mucho"]],"Inferioridad."],["m","Utah es menos grande <strong>_____</strong> Texas.",[["que",1],["como"],["de"],["tan"]],"menos… que."],["m","Tengo más <strong>_____</strong> diez libros.",[["de",1],["que"],["como"],["tan"]],"Con números se usa <strong>de</strong>: más de diez."],["o","Ordena las palabras para formar la frase.",[["Madrid es más grande que Vernal.",1]],"más + adjetivo + que."]],"A2"],["Comparación 2 · tan / tanto como","<strong>tan</strong> + adjetivo; <strong>tanto, tanta, tantos, tantas</strong> + sustantivo.",[["m","Ana es <strong>_____</strong> alta como Marta.",[["tan",1],["tanto"],["tanta"],["más"]],"tan + adjetivo."],["m","Tengo <strong>_____</strong> libros como tú.",[["tantos",1],["tan"],["tanto"],["tantas"]],"Libros: tantos."],["m","Hay <strong>_____</strong> agua como ayer.",[["tanta",1],["tan"],["tanto"],["tantas"]],"Agua: tanta."],["m","Tiene <strong>_____</strong> paciencia como su abuela.",[["tanta",1],["tan"],["tanto"],["tantos"]],"Paciencia: tanta."],["m","Corre <strong>_____</strong> como su hermano.",[["tanto",1],["tan"],["tanta"],["tantos"]],"Con verbo: tanto."],["m","Es <strong>_____</strong> simpático como su padre.",[["tan",1],["tanto"],["tanta"],["tantos"]],"tan + adjetivo."],["m","Este examen es tan fácil <strong>_____</strong> el anterior.",[["como",1],["que"],["de"],["tan"]],"tan… <strong>como</strong>."],["s","Tengo <strong>_____</strong> (tanto) amigas como tú. <em>(Escribe la respuesta.)</em>",[["tantas",1]],"tantas."]],"B1"],["Comparación 3 · ¿qué comparación es?","Superioridad, inferioridad o igualdad.",[["m","Leo es más rápido que Pablo.",[["Superioridad",1],["Inferioridad"],["Igualdad"]],"Superioridad."],["m","El agua está tan fría como el hielo.",[["Igualdad",1],["Superioridad"],["Inferioridad"]],"Igualdad."],["m","La bici es menos cara que la moto.",[["Inferioridad",1],["Superioridad"],["Igualdad"]],"Inferioridad."],["m","Tengo tantos cromos como tú.",[["Igualdad",1],["Superioridad"],["Inferioridad"]],"Igualdad."],["m","El perro es más grande que el gato.",[["Superioridad",1],["Inferioridad"],["Igualdad"]],"Superioridad."],["m","Mi casa es menos antigua que la tuya.",[["Inferioridad",1],["Superioridad"],["Igualdad"]],"Inferioridad."],["m","Lee tanto como su madre.",[["Igualdad",1],["Superioridad"],["Inferioridad"]],"Igualdad."],["m","Hoy hace más frío que ayer.",[["Superioridad",1],["Inferioridad"],["Igualdad"]],"Superioridad."]],"A2"],["Comparación 4 · mejor, peor, mayor, menor","Comparativos irregulares: no se dice «más bueno», sino <strong>mejor</strong>.",[["m","Este pastel es <strong>_____</strong> que aquel. (bueno)",[["mejor",1],["más bueno"],["más mejor"],["bueníssimo"]],"bueno → <strong>mejor</strong>."],["m","Hoy el tiempo está <strong>_____</strong> que ayer. (malo)",[["peor",1],["más malo"],["más peor"],["malísimo que"]],"malo → <strong>peor</strong>."],["m","Mi hermana tiene 15 años; yo, 11. Ella es <strong>_____</strong> que yo.",[["mayor",1],["menor"],["más grande de"],["más mayor"]],"Edad: <strong>mayor</strong>."],["m","Yo soy <strong>_____</strong> que ella.",[["menor",1],["mayor"],["más pequeño de"],["más menor"]],"<strong>menor</strong>."],["m","Elige la correcta.",[["Juega mejor que yo.",1],["Juega más mejor que yo."],["Juega más bien que yo."],["Juega mejor como yo."]],"mejor que."],["m","Elige la correcta.",[["Es el mejor jugador.",1],["Es el más mejor jugador."],["Es el más bueno jugador."],["Es el mejorísimo jugador."]],"el mejor."],["x","Une.",[["bueno","mejor"],["malo","peor"],["grande (edad)","mayor"],["pequeño (edad)","menor"]],"Comparativos irregulares."],["s","Este helado está <strong>_____</strong> que el otro. (bueno) <em>(Escribe la respuesta.)</em>",[["mejor",1]],"mejor."]],"A2"],["Comparación 5 · el superlativo","Para destacar: <strong>el más…</strong>, <strong>muy…</strong> o <strong>-ísimo</strong>.",[["m","El Everest es <strong>_____</strong> montaña más alta del mundo.",[["la",1],["el"],["una"],["más"]],"la más alta."],["m","alto → <strong>_____</strong>",[["altísimo",1],["altoísimo"],["altísmo"],["altisimo"]],"alto → <strong>altísimo</strong>."],["m","fácil → <strong>_____</strong>",[["facilísimo",1],["fácilísimo"],["facilsimo"],["fácilisimo"]],"<strong>facilísimo</strong> (la tilde pasa a -ísimo)."],["m","rico → <strong>_____</strong>",[["riquísimo",1],["ricoísimo"],["ricísimo"],["riquisimo"]],"c → qu: <strong>riquísimo</strong>."],["m","largo → <strong>_____</strong>",[["larguísimo",1],["largísimo"],["largoísimo"],["larguisimo"]],"g → gu: <strong>larguísimo</strong>."],["m","«Muy bonito» es igual a…",[["bonitísimo",1],["más bonito"],["tan bonito"],["bonitoso"]],"Superlativo absoluto."],["s","feliz → <strong>_____</strong> (con -ísimo) <em>(Escribe la respuesta.)</em>",[["felicísimo",1]],"z → c: <strong>felicísimo</strong>."],["s","grande → <strong>_____</strong> (con -ísimo) <em>(Escribe la respuesta.)</em>",[["grandísimo",1]],"<strong>grandísimo</strong>."]],"B1"],["Comparación 6 · escribe la comparación","Completa con la forma correcta.",[["s","Un león es <strong>_____</strong> fuerte que un gato. <em>(Escribe la respuesta.)</em>",[["más",1]],"más."],["s","Mi bici es tan rápida <strong>_____</strong> la tuya. <em>(Escribe la respuesta.)</em>",[["como",1]],"como."],["s","Tengo <strong>_____</strong> hermanos como tú. (tanto) <em>(Escribe la respuesta.)</em>",[["tantos",1]],"tantos."],["s","Este libro es <strong>_____</strong> que aquel. (bueno) <em>(Escribe la respuesta.)</em>",[["mejor",1]],"mejor."],["s","Es la <strong>_____</strong> película del año. (buena) <em>(Escribe la respuesta.)</em>",[["mejor",1]],"la mejor."],["s","Hace <strong>_____</strong> calor que ayer. <em>(Escribe la respuesta.)</em>",[["más",1],["menos",1]],"más (o menos)."],["o","Ordena las palabras para formar la frase.",[["Mi abuelo es mayor que mi abuela.",1]],"mayor que."],["o","Ordena las palabras para formar la frase.",[["Esta sopa está riquísima.",1]],"Superlativo con -ísima."]],"B1"],["Comparación 7 · repaso","Repaso de la comparación.",[["m","Pedro tiene 10 años y Luis, 12. →",[["Pedro es menor que Luis.",1],["Pedro es mayor que Luis."],["Pedro es tan mayor como Luis."],["Pedro es más mayor que Luis."]],"menor."],["m","Un kilo de paja pesa <strong>_____</strong> un kilo de hierro.",[["tanto como",1],["más que"],["menos que"],["tan como"]],"Pesan igual: tanto como."],["m","Elige la correcta.",[["Es más listo que su hermano.",1],["Es más listo como su hermano."],["Es tan listo que su hermano."],["Es más listo de su hermano."]],"más… que."],["m","Superlativo de <strong>bueno</strong>:",[["buenísimo",1],["bonísimo"],["buenoísimo"],["buenisísimo"]],"También existe «óptimo», más formal."],["m","Elige la correcta.",[["Tengo menos de veinte euros.",1],["Tengo menos que veinte euros."],["Tengo menos como veinte euros."],["Tengo tan veinte euros."]],"Con números: menos de."],["m","Elige la correcta.",[["Es peor que antes.",1],["Es más peor que antes."],["Es más malo como antes."],["Es peor como antes."]],"peor que."],["s","Corre <strong>_____</strong> como un guepardo. (tanto) <em>(Escribe la respuesta.)</em>",[["tanto",1]],"tanto como."],["s","poco → <strong>_____</strong> (con -ísimo) <em>(Escribe la respuesta.)</em>",[["poquísimo",1]],"c → qu."]],"B1"]]}