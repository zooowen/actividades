=\"130\" text-anchor=\"middle\" font-size=\"26\">🐁</text><text x=\"130\" y=\"162\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" font-weight=\"700\">ratón</text><circle cx=\"40\" cy=\"100\" r=\"26\" fill=\"#fff\" stroke=\"#adb5bd\"/><text x=\"40\" y=\"110\" text-anchor=\"middle\" font-size=\"26\">🦉</text><text x=\"40\" y=\"142\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" font-weight=\"700\">búho</text><circle cx=\"130\" cy=\"40\" r=\"26\" fill=\"#fff\" stroke=\"#adb5bd\"/><text x=\"130\" y=\"50\" text-anchor=\"middle\" font-size=\"26\">🐍</text><text x=\"130\" y=\"82\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" font-weight=\"700\">serpiente</text><circle cx=\"290\" cy=\"40\" r=\"26\" fill=\"#fff\" stroke=\"#adb5bd\"/><text x=\"290\" y=\"50\" text-anchor=\"middle\" font-size=\"26\">🦅</text><text x=\"290\" y=\"82\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" font-weight=\"700\">halcón</text><circle cx=\"340\" cy=\"95\" r=\"26\" fill=\"#fff\" stroke=\"#adb5bd\"/><text x=\"340\" y=\"105\" text-anchor=\"middle\" font-size=\"26\">🦊</text><text x=\"340\" y=\"137\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" font-weight=\"700\">zorro</text><circle cx=\"480\" cy=\"110\" r=\"26\" fill=\"#fff\" stroke=\"#adb5bd\"/><text x=\"480\" y=\"120\" text-anchor=\"middle\" font-size=\"26\">🐆</text><text x=\"480\" y=\"152\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" font-weight=\"700\">puma</text><text x=\"10\" y=\"336\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#5b6476\">La flecha va del ser vivo que es comido al que se lo come: indica hacia dónde va la energía.</text></svg>"],"preguntas":[["a","Marca todo lo que come <b>saltamontes</b> en la red. <em>(Marca todas las correctas.)</em>",[["hierba",1],["artemisa"],["conejo"]],"saltamontes: hierba."],["a","Marca todo lo que come <b>conejo</b> en la red. <em>(Marca todas las correctas.)</em>",[["hierba",1],["artemisa",1],["saltamontes"],["ratón"]],"conejo: hierba, artemisa."],["a","Marca todo lo que come <b>ciervo</b> en la red. <em>(Marca todas las correctas.)</em>",[["artemisa",1],["hierba"],["saltamontes"]],"ciervo: artemisa."],["a","Marca todo lo que come <b>ratón</b> en la red. <em>(Marca todas las correctas.)</em>",[["hierba",1],["saltamontes",1],["artemisa"],["conejo"]],"ratón: hierba, saltamontes."],["a","Marca todo lo que come <b>búho</b> en la red. <em>(Marca todas las correctas.)</em>",[["ratón",1],["hierba"],["artemisa"]],"búho: ratón."],["m","¿Qué animal está en lo más alto de la red, sin depredadores en ella?",[["el puma",1],["el conejo"],["el ratón"],["el saltamontes"]],"Ninguna flecha sale del puma."],["m","Si una enfermedad acaba con los conejos, ¿qué animales se ven más afectados?",[["zorro, halcón y puma",1],["hierba y artemisa"],["saltamontes"],["serpiente"]],"Todos comen conejos."]]},{"titulo":"Cadena trófica","nivel":"Nivel 2","texto":["Repasa la cadena trófica con estas fotos.<div class=\"figs\"><figure class=\"foto\"><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0b/Green_leaf_texture.jpg/960px-Green_leaf_texture.jpg\" alt=\"Hoja verde: aquí se hace la fotosíntesis\" loading=\"lazy\" referrerpolicy=\"no-referrer\" onerror=\"this.parentNode.style.display='none'\"><figcaption>Hoja verde: aquí se hace la fotosíntesis. <a href=\"https://commons.wikimedia.org/wiki/File:Green_leaf_texture.jpg\" target=\"_blank\" rel=\"noopener\">Foto: Martin Vorel · CC BY-SA 4.0</a></figcaption></figure><figure class=\"foto\"><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/51/Short-horned_grasshopper_(Rhytidochrota_risaraldae)_female.jpg/960px-Short-horned_grasshopper_(Rhytidochrota_risaraldae)_female.jpg\" alt=\"Saltamontes: come hojas\" loading=\"lazy\" referrerpolicy=\"no-referrer\" onerror=\"this.parentNode.style.display='none'\"><figcaption>Saltamontes: come hojas. <a href=\"https://commons.wikimedia.org/wiki/File:Short-horned_grasshopper_(Rhytidochrota_risaraldae)_female.jpg\" target=\"_blank\" rel=\"noopener\">Foto: Charles J. Sharp · CC BY-SA 4.0</a></figcaption></figure><figure class=\"foto\"><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/84/Frog_and_waterlily_at_Trustom_Pond_(12300).jpg/960px-Frog_and_waterlily_at_Trustom_Pond_(12300).jpg\" alt=\"Rana en un estanque\" loading=\"lazy\" referrerpolicy=\"no-referrer\" onerror=\"this.parentNode.style.display='none'\"><figcaption>Rana en un estanque. <a href=\"https://commons.wikimedia.org/wiki/File:Frog_and_waterlily_at_Trustom_Pond_(12300).jpg\" target=\"_blank\" rel=\"noopener\">Foto: Rhododendrites · CC BY-SA 4.0</a></figcaption></figure><figure class=\"foto\"><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c0/California_Red-Sided_Garter_Snake_(Thamnophis_sirtalis_infernalis).jpg/960px-California_Red-Sided_Garter_Snake_(Thamnophis_sirtalis_infernalis).jpg\" alt=\"Culebra de jarretera\" loading=\"lazy\" referrerpolicy=\"no-referrer\" onerror=\"this.parentNode.style.display='none'\"><figcaption>Culebra de jarretera. <a href=\"https://commons.wikimedia.org/wiki/File:California_Red-Sided_Garter_Snake_(Thamnophis_sirtalis_infernalis).jpg\" target=\"_blank\" rel=\"noopener\">Foto: Jaden Clark · CC BY 4.0</a></figcaption></figure><figure class=\"foto\"><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/76/Red-tailed_hawk_(44371).jpg/960px-Red-tailed_hawk_(44371).jpg\" alt=\"Busardo colirrojo, el halcón de cola roja\" loading=\"lazy\" referrerpolicy=\"no-referrer\" onerror=\"this.parentNode.style.display='none'\"><figcaption>Busardo colirrojo, el halcón de cola roja. <a href=\"https://commons.wikimedia.org/wiki/File:Red-tailed_hawk_(44371).jpg\" target=\"_blank\" rel=\"noopener\">Foto: Rhododendrites · CC BY-SA 4.0</a></figcaption></figure></div>"],"preguntas":[["o","Ordena la cadena trófica de las fotos.",[["hoja saltamontes rana serpiente halcón",1]],"hoja → saltamontes → rana → serpiente → halcón."],["m","¿Cuál es el consumidor primario de esa cadena?",[["el saltamontes",1],["la rana"],["la serpiente"],["el halcón"]],"Come hojas."],["m","¿Cuál es el consumidor secundario?",[["la rana",1],["el saltamontes"],["la hoja"],["el halcón"]],"Come al saltamontes."],["m","¿Cuántos eslabones tiene la cadena?",[["5",1],["3"],["4"],["6"]],"hoja, saltamontes, rana, serpiente y halcón."],["s","Escribe el productor de la cadena: <em>(Escribe la respuesta.)</em>",[["hoja",1],["la hoja",1],["planta",1],["la planta",1],["las hojas",1]],"La hoja (la planta)."]]},{"titulo":"Cadenas y redes alimenticias","nivel":"Nivel 3","texto":["Repaso final: productores, consumidores, descomponedores, cadenas y redes. Recuerda que la energía llega del sol a las plantas y pasa de un ser vivo a otro, mientras la materia se recicla gracias a los descomponedores.<div class=\"figs\"><figure class=\"foto\"><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6a/Sunflower_and_grain_field_in_Baix_Empord%C3%A0.jpg/960px-Sunflower_and_grain_field_in_Baix_Empord%C3%A0.jpg\" alt=\"Campo de girasoles\" loading=\"lazy\" referrerpolicy=\"no-referrer\" onerror=\"this.parentNode.style.display='none'\"><figcaption>Campo de girasoles. <a href=\"https://commons.wikimedia.org/wiki/File:Sunflower_and_grain_field_in_Baix_Empord%C3%A0.jpg\" target=\"_blank\" rel=\"noopener\">Foto: Kritzolina · CC BY-SA 4.0</a></figcaption></figure><figure class=\"foto\"><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5b/Common_Earthworm_(Lumbricus_terrestris)_Plug%2C_Chapeltoun%2C_Scotland.JPG/960px-Common_Earthworm_(Lumbricus_terrestris)_Plug%2C_Chapeltoun%2C_Scotland.JPG\" alt=\"Lombriz de tierra: un descomponedor\" loading=\"lazy\" referrerpolicy=\"no-referrer\" onerror=\"this.parentNode.style.display='none'\"><figcaption>Lombriz de tierra: un descomponedor. <a href=\"https://commons.wikimedia.org/wiki/File:Common_Earthworm_(Lumbricus_terrestris)_Plug%2C_Chapeltoun%2C_Scotland.JPG\" target=\"_blank\" rel=\"noopener\">Foto: Rosser1954 · CC BY-SA 4.0</a></figcaption></figure></div>"],"preguntas":[["m","¿De dónde viene al principio la energía de todas las cadenas alimentarias?",[["Del sol",1],["Del suelo"],["Del agua"],["De los carnívoros"]],"Los productores la captan con la fotosíntesis."],["m","¿Qué se recicla en un ecosistema gracias a los descomponedores?",[["La materia (nutrientes)",1],["La luz del sol"],["Las rocas"],["El viento"]],"Vuelve al suelo."],["x","Une cada ejemplo con su papel.",[["lombriz","descomponedor"],["cactus","productor"],["búho","carnívoro"],["ciervo","herbívoro"]],"Repaso."],["m","Una red alimenticia es más estable que una cadena porque…",[["si falta un alimento, los animales pueden comer otro",1],["tiene menos animales"],["no tiene plantas"],["no tiene flechas"]],"Hay más conexiones."],["m","Los productores fabrican su alimento.",[["Verdadero",1],["Falso"]],"Verdadero."],["m","Los descomponedores son siempre animales grandes.",[["Falso",1],["Verdadero"]],"Falso."],["m","Las flechas indican el camino de la energía.",[["Verdadero",1],["Falso"]],"Verdadero."],["g","Completa.",[["",1]],"sol, productores, herbívoros.","La energía viene del {{sol*|suelo|agua}}. Las plantas son {{productores*|consumidores|descomponedores}}. Los animales que comen plantas son {{herbívoros*|carnívoros|productores}}."]]}]}