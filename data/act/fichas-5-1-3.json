s caluroso en Vernal?",[["julio",1],["enero"],["abril"],["octubre"]],"Unos 23 °C."],["m","¿Cuál es el mes más frío?",[["enero",1],["julio"],["mayo"],["septiembre"]],"Unos -9 °C."],["m","¿En qué mes llueve o nieva más?",[["mayo",1],["enero"],["julio"],["diciembre"]],"26 mm."],["m","¿Qué representa la línea roja?",[["La temperatura media de cada mes",1],["La lluvia"],["El viento"],["Las horas de sol"]],"Rojo = temperatura."],["m","¿Qué representan las barras azules?",[["La precipitación (lluvia y nieve)",1],["La temperatura"],["La altura de las montañas"],["Los terremotos"]],"Azul = precipitación."],["a","¿En qué meses la temperatura media está bajo 0 °C? <em>(Marca todas las correctas.)</em>",[["enero",1],["febrero",1],["diciembre",1],["julio"],["mayo"]],"En invierno."],["m","En marzo y noviembre la temperatura pasa de bajo cero a sobre cero muchos días. ¿Qué meteorización es más fuerte?",[["La del hielo: el agua se congela y se deshiela en las grietas",1],["La de las olas"],["La de la lava"],["Ninguna"]],"Los ciclos de hielo y deshielo rompen las rocas."],["m","¿Cuántos grados hay de diferencia entre julio y enero?",[["32 °C",1],["10 °C"],["20 °C"],["14 °C"]],"23 − (-9) = 32."]]}]}